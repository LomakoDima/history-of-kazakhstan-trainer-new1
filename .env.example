# Copy this file to .env and replace the placeholder locally.
# Never commit your real .env file.
ANTHROPIC_API_KEY=replace_with_your_key
# Optional: claude-opus-5-5 is the default. claude-sonnet-5-5 or claude-haiku-5-5 are cheaper.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: thinking depth (low, medium, high, xhigh, max). Leave empty for models without effort support.
ANTHROPIC_EFFORT=low
PORT=8787

# Optional abuse protection (mainly for a public Vercel deployment):
# ACCESS_CODE=choose_a_shared_code_for_your_students
# REVIEW_RATE_LIMIT=5          # reviews per IP per 10 minutes
# REVIEW_DAILY_LIMIT=300       # reviews per day per server instance
# ALLOWED_ORIGINS=https://your-custom-domain.example
